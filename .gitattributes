# Normalise line endings: store and check out text as LF on every OS
* text=auto eol=lf

# Code and text
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.gs   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.zip  binary
